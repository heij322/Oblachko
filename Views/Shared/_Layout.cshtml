@inject SignInManager<IdentityUser> SignInManager
<!doctype html>
<html lang="ru">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@(ViewData["Title"] is string title ? title + " — " : "")Пекарня Облачко</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Oswald:wght@500;700&family=Golos+Text:wght@400;500;600&family=Caveat:wght@600&family=JetBrains+Mono:wght@400;700&display=swap">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
</head>
<body>
    <header class="site-header">
        <div class="container header-row">
            <a class="logo" href="/">ОБЛАЧКО <span>пекарня, Ижевск</span></a>
            <nav class="nav">
                <a href="/#oven">Печь сегодня</a>
                <a href="/#menu">Меню</a>
                @if (SignInManager.IsSignedIn(User))
                {
                    <a asp-controller="Orders" asp-action="My">Мои заказы</a>
                    if (User.IsInRole("Admin"))
                    {
                        <a asp-controller="Admin" asp-action="Index">Админка</a>
                    }
                    <form asp-controller="Account" asp-action="Logout" method="post" class="inline-form">
                        <button type="submit" class="nav-button">Выйти</button>
                    </form>
                }
                else
                {
                    <a class="nav-button" asp-controller="Account" asp-action="Login">Войти</a>
                }
            </nav>
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="site-footer" id="contacts">
        <div class="container footer-grid">
            <div>
                <strong class="footer-logo">ОБЛАЧКО</strong>
                <span class="muted">пекарня, Ижевск</span>
            </div>
            <div>
                <strong>Адрес</strong>
                <span>Ижевск, ул. Пушкинская</span>
            </div>
            <div>
                <strong>Часы</strong>
                <span>ежедневно 7:00–21:00</span>
            </div>
            <div>
                <strong>Телефон</strong>
                <span>+7 (3412) 00-00-00</span>
            </div>
        </div>
        <div class="bread-letters" aria-hidden="true">ОБЛАЧКО</div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
