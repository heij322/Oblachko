@model List<Order>
@{
    ViewData["Title"] = "Мои заказы";
}

<section class="container section">
    <div class="section-head">
        <h1 class="page-title">Мои заказы</h1>
        <a class="link" href="/#menu">В меню</a>
    </div>

    @if (Model.Count == 0)
    {
        <p class="muted">Заказов пока нет. Выберите что-нибудь в меню и нажмите «Предзаказать».</p>
    }
    else
    {
        <div class="receipt-grid">
            @foreach (var order in Model)
            {
                <a class="receipt receipt-mini" asp-action="Details" asp-route-id="@order.Id">
                    <div class="r-row"><span>№ @order.Id.ToString("D4")</span><span>@order.PickupDate.ToString("dd.MM")</span></div>
                    <hr class="dash">
                    <div class="r-row"><span>@order.Product?.Name × @order.Quantity</span></div>
                    <div class="r-row r-total"><span>ИТОГО</span><span>@order.Total.Rub()</span></div>
                    <div class="stamp-wrap">
                        <span class="stamp stamp-small @OrderStatuses.CssClass(order.Status)">@order.Status.ToUpper()</span>
                    </div>
                </a>
            }
        </div>
    }
</section>
